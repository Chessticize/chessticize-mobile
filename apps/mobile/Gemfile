source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version.
# The locked CocoaPods bundle is verified with Ruby 3.3; Active Support 7.2 needs 3.1+.
ruby ">= 3.1.0"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.16.2'
# 7.2.3.1+ carries the Active Support security fixes; CocoaPods 1.16 needs < 8.
gem 'activesupport', '>= 7.2.3.1', '< 8'
gem 'xcodeproj', '>= 1.27.0', '< 2.0'
# The template's `< 1.3.4` cap only worked around Active Support 6.1/7.0, which
# broke on concurrent-ruby 1.3.5's logger change; 7.2 loads logger itself.
gem 'concurrent-ruby', '>= 1.3.7'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
