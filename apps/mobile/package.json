{
  "name": "ChessticizeMobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "node scripts/ios-release-version.js && react-native run-ios",
    "ios:dev:device": "bash scripts/ios-run-dev-device.sh",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:native-stockfish": "node scripts/test-stockfish-runner-lifecycle.mjs",
    "typecheck": "tsc --noEmit",
    "doctor:ios": "scripts/ios-doctor.sh",
    "doctor:android": "node scripts/android-doctor.js",
    "install:android-sdk": "node scripts/install-android-sdk.js",
    "e2e:build:ios": "node scripts/ios-release-version.js && detox build --configuration ios.sim.debug",
    "e2e:build:ios:release": "node scripts/ios-release-version.js && detox build --configuration ios.sim.release",
    "e2e:test:ios": "CHESSTICIZE_E2E_EXPECTED_VERSION_SOURCE=debug detox test --configuration ios.sim.debug",
    "e2e:test:ios:release": "CHESSTICIZE_E2E_EXPECTED_VERSION_SOURCE=release detox test --configuration ios.sim.release",
    "e2e:test:ios:ci": "CHESSTICIZE_E2E_EXPECTED_VERSION_SOURCE=debug detox test --configuration ios.sim.debug --cleanup",
    "e2e:resource-soak:ios": "CHESSTICIZE_RUN_RESOURCE_SOAK=1 detox test --configuration ios.sim.debug --artifacts-location artifacts/resource-soak e2e/resource-soak.e2e.js",
    "e2e:store-assets:ios": "CHESSTICIZE_CAPTURE_STORE_ASSETS=1 detox test --configuration ios.sim.debug --artifacts-location artifacts/store-assets e2e/store-assets.e2e.js",
    "e2e:store-assets:ios:release": "CHESSTICIZE_CAPTURE_STORE_ASSETS=1 detox test --configuration ios.sim.release --artifacts-location artifacts/store-assets e2e/store-assets.e2e.js",
    "e2e:marketing-assets:ios": "CHESSTICIZE_CAPTURE_MARKETING_ASSETS=1 detox test --configuration ios.sim.debug --artifacts-location artifacts/marketing-assets e2e/marketing-assets.e2e.js",
    "e2e:marketing-assets:ios:release": "CHESSTICIZE_CAPTURE_MARKETING_ASSETS=1 detox test --configuration ios.sim.release --artifacts-location artifacts/marketing-assets e2e/marketing-assets.e2e.js",
    "e2e:verify:ios:landscape-layout": "CHESSTICIZE_VERIFY_IOS_LANDSCAPE_LAYOUT=1 detox test --configuration ios.sim.release e2e/marketing-assets.e2e.js",
    "verify:ios:landscape-layout": "bash scripts/ios-verify-landscape-layout.sh",
    "capture:marketing-assets:ios": "bash scripts/capture-app-store-marketing-assets.sh",
    "finalize:marketing-assets": "node scripts/finalize-marketing-capture.js",
    "capture:marketing-assets:android": "bash e2e/capture-google-play-marketing-assets.sh",
    "capture:marketing-public-ui-frame:android": "node e2e/capture-google-play-public-ui-frame.js",
    "record:marketing-assets:android": "node e2e/record-google-play-public-ui-capture.js",
    "finalize:marketing-assets:android": "node e2e/finalize-google-play-marketing-capture.js",
    "e2e:adaptive-layout:ios": "CHESSTICIZE_CAPTURE_ADAPTIVE_LAYOUT=1 detox test --configuration ios.sim.debug --artifacts-location artifacts/adaptive-layout e2e/adaptive-layout.e2e.js",
    "e2e:adaptive-layout:android": "scripts/android-adaptive-layout-evidence.sh",
    "e2e:build:android": "detox build --configuration android.attached.e2e",
    "build:android:r8-validation": "cd android && ./gradlew assembleR8Validation bundleR8Validation assembleR8ValidationAndroidTest -DtestBuildType=r8Validation",
    "e2e:test:android": "scripts/android-test-for-detox.sh",
    "e2e:test:android:ci": "scripts/android-test-for-detox.sh --cleanup",
    "validate:android:matrix": "node scripts/android-validation-matrix.js",
    "validate:android:r8": "scripts/android-r8-native-evidence.sh",
    "benchmark:android:runtime": "node scripts/android-runtime-benchmark.js",
    "verify:android:abis": "node scripts/verify-android-apk-abis.js android/app/build/outputs/apk/e2e/app-e2e.apk",
    "verify:android:r8": "node scripts/android-r8-evidence.js",
    "verify:android:backup": "node scripts/verify-android-progress-backup.js",
    "verify:android:release": "node scripts/android-play-release.js",
    "verify:android:github-release": "node scripts/android-github-release-cli.js",
    "generate:android:launcher-icons": "node scripts/android-launcher-icons.js",
    "check:android:launcher-icons": "node scripts/android-launcher-icons.js --check",
    "version:ios:sync": "node scripts/ios-release-version.js",
    "version:ios:check": "node scripts/ios-release-version.js --check"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "17.1.1",
    "@shopify/react-native-skia": "^2.6.5",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-chessboard": "0.2.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-reanimated": "^4.4.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-worklets": "^0.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/codegen": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/gradle-plugin": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@testing-library/react-native": "14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "29.7.0",
    "detox": "20.51.4",
    "eslint": "^8.19.0",
    "expect": "29.7.0",
    "hermes-compiler": "250829098.0.14",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "pngjs": "7.0.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
