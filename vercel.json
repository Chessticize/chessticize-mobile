{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/storybook-ci.mjs vercel-build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/mobile-lab/storybook-static",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/storybook",
      "destination": "/index.html"
    },
    {
      "source": "/storybook/",
      "destination": "/index.html"
    },
    {
      "source": "/storybook/:path*",
      "destination": "/:path*"
    }
  ]
}
