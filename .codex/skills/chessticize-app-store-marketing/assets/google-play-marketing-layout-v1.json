    {
      "order": 6,
      "frameId": "private-offline-open-source",
      "captureId": "marketing-06-trust",
      "copyKey": "private-offline-open-source",
      "headline": "Private. Offline. Open Source.",
      "supporting": "No ads. No Chessticize account. No developer data collection.",
      "fileName": "marketing-06-trust.png"
    }
