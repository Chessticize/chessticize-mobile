+// Chessticize patch (#637): after a live text size change, Fabric dirties the
+// measurement of every paragraph in its own tree revision, but the next React
+// commit is built from the shadow nodes React holds. Text whose props did not
+// change keeps its old measurement and stays clipped at the old size until
+// relaunch. Passing the font scale as an inert native prop gives every scaling
+// Text exactly one props update per font-scale change, so Fabric re-measures it
+// with the current multiplier, without remounting anything.
+let currentFontScale: number = Dimensions.get('window').fontScale;
+const fontScaleListeners: Set<() => void> = new Set();
+let fontScaleSubscribed = false;
+
+function subscribeToFontScale(listener: () => void): () => void {
+  fontScaleListeners.add(listener);
+  if (!fontScaleSubscribed) {
+    fontScaleSubscribed = true;
+    Dimensions.addEventListener('change', ({window}) => {
+      if (window.fontScale !== currentFontScale) {
+        currentFontScale = window.fontScale;
+        fontScaleListeners.forEach(notify => notify());
+      }
+    });
+  }
+  return () => {
+    fontScaleListeners.delete(listener);
+  };
+}
+
+function getFontScale(): number {
+  return currentFontScale;
+}
